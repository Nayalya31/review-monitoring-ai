ENVIRONMENT=development
TARGET_SITE_URL=http://127.0.0.1:5050
WORKER_API_TOKEN=
WORKER_POLL_INTERVAL=10
DATABASE_PATH=data/reviews.sqlite3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT=25
LLM_ATTEMPTS=2
LLM_DAILY_REQUESTS=50
LLM_MAX_OUTPUT_TOKENS=600
CONFIDENCE_THRESHOLD=0.8
# Enable only after documenting legal basis; raw personal text still blocked.
EXTERNAL_PROCESSING_AUTHORIZED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_CHAT_ID=
TELEGRAM_INCLUDE_TEXT=false
NOTIFY_NON_NEGATIVE=false
# Website environment: isolated database, same host directory as worker bind mount.
REVIEWS_DATABASE_PATH=data/reviews.sqlite3
REVIEWS_INTAKE_ENABLED=false
PRIVACY_POLICY_URL=
CONSENT_VERSION=

# Set only to verified nginx/Traefik addresses after deployment audit.
REVIEWS_TRUSTED_PROXY_IPS=
REVIEWS_GITHUB_URL=
